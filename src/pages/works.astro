---
// STAND-BY: página sem links no site e fora do Google.
// Para ativar: remova "noindex" abaixo, tire o filtro do sitemap em astro.config.mjs
// e adicione um link para /works em Header.astro.
import Layout from "../layouts/Layout.astro";
import VideoCard from "../components/VideoCard.astro";
import { longForm, shorts } from "../data/videos";
---

<Layout
    title="Works"
    description="Long-form and short-form video editing work by Midas Editing."
    timeline={false}
    noindex
>
    <section class="px-5 md:px-10 pt-28 pb-16">
        <h1 class="display text-6xl md:text-[8vw]">All the work.</h1>
        <div class="grid md:grid-cols-2 gap-x-6 gap-y-10 mt-12">
            {longForm.map((video) => (
                <VideoCard youtubeId={video.youtubeId} title={video.title} client={video.client} sizes="(min-width: 768px) 50vw, 100vw" />
            ))}
        </div>
        <p class="eyebrow mt-16 mb-4">Short form</p>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
            {shorts.map((video) => (
                <VideoCard youtubeId={video.youtubeId} vertical />
            ))}
        </div>
    </section>
</Layout>
