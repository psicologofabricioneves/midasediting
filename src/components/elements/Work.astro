<script>
  const cards = document.querySelectorAll(".work-card");
  const modal = document.getElementById("video-modal");
  const modalVideo = document.getElementById("modal-video");
  const closeModal = document.getElementById("close-video-modal");

  const isMobile = window.matchMedia("(max-width: 767px)").matches;

  cards.forEach((card) => {
    const preview = card.querySelector(".preview-video");
    const button = card.querySelector(".play-button");
    const src = card.dataset.video;

    if (isMobile) {
      // No celular: carrega somente para conseguir exibir um frame parado
      preview.preload = "auto";

      const showStaticFrame = () => {
        preview.pause();
        preview.currentTime = 0.05;
      };

      if (preview.readyState >= 1) {
        showStaticFrame();
      } else {
        preview.addEventListener("loadedmetadata", showStaticFrame, {
          once: true,
        });
      }

      preview.load();
    } else {
      // Desktop: mantém preview ao passar o mouse
      card.addEventListener("mouseenter", () => {
        preview.play();
      });

      card.addEventListener("mouseleave", () => {
        preview.pause();
        preview.currentTime = 0;
      });
    }

    // Desktop e mobile: abre o vídeo normalmente
    button.addEventListener("click", () => {
      preview.pause();

      modalVideo.src = src;
      modalVideo.currentTime = 0;

      modal.classList.remove("hidden");
      modal.classList.add("flex");

      modalVideo.play();
    });
  });

  function closePlayer() {
    modalVideo.pause();
    modalVideo.currentTime = 0;
    modalVideo.removeAttribute("src");
    modalVideo.load();

    modal.classList.add("hidden");
    modal.classList.remove("flex");
  }

  closeModal.addEventListener("click", closePlayer);

  modal.addEventListener("click", (event) => {
    if (event.target === modal) {
      closePlayer();
    }
  });
</script>