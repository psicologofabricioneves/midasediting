---
import Text from "../elements/Text.astro";

const { slug, title, client } = Astro.props;

const videos = {
  "cloudsync-suite": "lgcm4pJA9Ms",
  "lumina": "7ubNn84pf20",
  "nourish-restaurant": "d-t9YbVNNHk",
  "smart-speaker": "JcDLZtfOQJA",
};

const youtubeId = videos[slug];

const thumbnail = youtubeId
  ? `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`
  : "";
---

<div
  class="work-card w-full"
  data-youtube-id={youtubeId}
>
  <div
    class="relative w-full aspect-video overflow-hidden group cursor-pointer"
  >

    <!-- THUMBNAIL -->
    <img
      src={thumbnail}
      alt={`Thumbnail de ${title}`}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
    />

    <!-- PLAY BUTTON -->
    <button
      type="button"
      class="play-button absolute inset-0 flex items-center justify-center cursor-pointer group/play outline-none focus:outline-none focus:ring-0"
      aria-label={`Play ${title}`}
    >
      <span
        class="flex items-center justify-center w-24 h-24 rounded-full bg-black/60 border-2 border-white backdrop-blur-sm transition-all duration-300 group-hover/play:scale-110 group-hover/play:bg-black/80"
      >
        <svg
          viewBox="0 0 24 24"
          class="w-10 h-10 fill-white translate-x-[2px]"
          aria-hidden="true"
        >
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </button>

  </div>

  <p
    class="font-mono font-bold text-2xl md:text-3xl uppercase text-base-900"
  >
    {title}
  </p>

  <Text variant={"md"}>
    {client}
  </Text>
</div>

<!-- YOUTUBE MODAL -->
<div
  class="youtube-modal fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4 md:p-6"
>
  <button
    type="button"
    class="close-youtube-modal absolute top-6 right-6 text-white text-3xl cursor-pointer outline-none focus:outline-none focus:ring-0 z-10"
    aria-label="Close video"
  >
    ✕
  </button>

  <div class="w-full max-w-5xl aspect-video">
    <iframe
      class="youtube-player w-full h-full"
      src=""
      title={title}
      allow="autoplay; encrypted-media; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</div>

<script>
  const cards = document.querySelectorAll(".work-card");

  cards.forEach((card) => {
    const button = card.querySelector(".play-button");
    const youtubeId = card.getAttribute("data-youtube-id");

    const modal = card.nextElementSibling;

    if (!button || !youtubeId || !modal) return;

    const iframe = modal.querySelector(".youtube-player");
    const closeButton = modal.querySelector(".close-youtube-modal");

    if (!(iframe instanceof HTMLIFrameElement)) return;

    function openPlayer() {
      iframe.src =
        `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&rel=0`;

      modal.classList.remove("hidden");
      modal.classList.add("flex");

      document.body.style.overflow = "hidden";
    }

    function closePlayer() {
      iframe.src = "";

      modal.classList.add("hidden");
      modal.classList.remove("flex");

      document.body.style.overflow = "";
    }

    button.addEventListener("click", openPlayer);

    closeButton?.addEventListener("click", closePlayer);

    modal.addEventListener("click", (event) => {
      if (event.target === modal) {
        closePlayer();
      }
    });
  });
</script>