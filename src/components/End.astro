---
import { contacts } from "../data/site";

const { headingTag: HeadingTag = "h2" } = Astro.props;
---

<div class="h-56 md:h-96 mt-20" style="background: linear-gradient(to bottom, transparent, var(--color-gold-deep))" aria-hidden="true"></div>

<section id="end" data-chapter="The end" class="gold-leaf text-ink px-5 md:px-10 pt-6 pb-16 scroll-mt-4">
    <p class="font-mono text-xs uppercase tracking-wider mb-6"><span class="tc">02:30</span> / The end</p>

    <HeadingTag class="display title">
        You just watched<br />the whole page.
    </HeadingTag>

    <p class="text-xl md:text-3xl leading-snug max-w-3xl mt-8">
        Most sites lose people in seconds. You stayed to the end. That's what I do for your viewers. Long-form or short-form, tell me about your channel.
    </p>

    <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {contacts.map((contact) => (
            <li>
                <a
                    href={contact.href}
                    target={contact.href.startsWith("mailto:") ? undefined : "_blank"}
                    rel={contact.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                    class="h-full block bg-ink text-gold-soft hover:bg-bone hover:text-ink transition-colors px-5 py-5 md:px-6 md:py-6"
                >
                    <span class="display text-4xl md:text-5xl block">{contact.title}</span>
                    <span class="font-mono text-xs break-all mt-2 block">{contact.value}</span>
                </a>
            </li>
        ))}
    </ul>

    <p class="font-mono text-xs mt-16">Midas Editing © 2026 All Rights Reserved</p>
</section>
