---
import { topClients } from "../data/site";

const strip = topClients.map((client) => `${client.name} ${client.reach}`);
---

<section data-chapter="Hook" class="relative min-h-svh flex flex-col justify-between pt-20 md:pt-24 overflow-hidden">
    <div class="px-5 md:px-10 grid lg:grid-cols-[5fr_7fr] lg:grid-rows-[auto_1fr] gap-x-10 gap-y-6 lg:gap-y-8">
        <div>
            <p class="eyebrow mb-4 md:mb-5">In the myth, everything King Midas touched turned to gold.</p>
            <h1 class="display text-[14vw] md:text-[10vw] lg:text-[5.8vw]">
                Your footage,<br />
                turned to <span class="gold-word">gold.</span>
            </h1>
        </div>

        <figure class="lg:col-start-2 lg:row-start-1 lg:row-span-2">
            <video
                data-src="/videos/reel.mp4"
                poster="/videos/reel-poster.webp"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Fast montage of clips from videos edited by Midas"
                class="w-full aspect-video object-cover bg-soot"
            ></video>
        </figure>

        <div class="flex flex-col gap-5">
            <p class="text-lg md:text-xl leading-snug max-w-md">
                I'm Midas, a psychologist who edits long-form and short-form YouTube videos. I study why people look away, then I cut so they don't.
            </p>
            <div class="flex flex-wrap gap-3">
                <a href="#end" class="btn">Work with me</a>
                <a href="#work" class="btn btn-ghost">See the work</a>
            </div>
            <p class="eyebrow">Keep scrolling. This page turns gold by the end.</p>
        </div>
    </div>

    <div class="mt-6 mb-12 border-y border-soot overflow-hidden py-3" aria-label="Clients">
        <div class="marquee-track flex w-max font-mono text-sm uppercase">
            {[0, 1, 2, 3].map((copy) => (
                <ul class="flex shrink-0" aria-hidden={copy > 0 ? "true" : undefined}>
                    {strip.map((item) => (
                        <li class="px-6"><span class="text-gold mr-6" aria-hidden="true">●</span>{item}</li>
                    ))}
                </ul>
            ))}
        </div>
    </div>
</section>
