---
import Chapter from "./Chapter.astro";

const offers = [
    {
        name: "Long-form",
        text: "YouTube videos built to hold attention from the first second to the last.",
        items: ["Story structure and pacing", "Motion graphics and captions", "Retention-focused cuts"],
    },
    {
        name: "Short-form",
        text: "Shorts, Reels and TikToks built to stop the swipe.",
        items: ["Hook-first structure", "Dynamic captions", "Fast, deliberate pacing"],
    },
];
---

<Chapter name="Offer">
    <h2 class="display text-6xl md:text-[8vw]">Two ways to <span class="gold-word">work together.</span></h2>

    <div class="grid md:grid-cols-2 gap-6 mt-10 md:mt-14">
        {offers.map((offer) => (
            <article class="bg-ink/60 border border-lead/30 p-6 md:p-8 flex flex-col gap-5">
                <h3 class="display text-5xl md:text-6xl">{offer.name}</h3>
                <p class="text-lg leading-snug">{offer.text}</p>
                <ul class="flex flex-col gap-2 text-lead">
                    {offer.items.map((item) => <li>— {item}</li>)}
                </ul>
                <dl class="grid grid-cols-3 gap-3 mt-auto pt-5 border-t border-lead/30 text-sm">
                    <div><dt class="eyebrow">From</dt><dd class="mt-1"><span class="todo-inline">$ price</span></dd></div>
                    <div><dt class="eyebrow">Delivery</dt><dd class="mt-1"><span class="todo-inline">X days</span></dd></div>
                    <div><dt class="eyebrow">Revisions</dt><dd class="mt-1"><span class="todo-inline">X rounds</span></dd></div>
                </dl>
            </article>
        ))}
    </div>
</Chapter>
