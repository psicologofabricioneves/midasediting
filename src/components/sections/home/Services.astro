---
// content
import { shorts } from "../../../data/videos";

const { showAll = false } = Astro.props;
const visibleShorts = showAll ? shorts : shorts.filter((video) => video.featured);
---

<section class="w-full m-auto xl:max-w-[85%] flex flex-col gap-8">
  <h3 class="font-grunge uppercase text-base-900 text-64" style="line-height: 0.85">
    Short form
  </h3>

  <div class="flex overflow-x-auto snap-x gap-3 -mx-8 px-8 md:mx-0 md:px-0 md:grid md:grid-cols-5 md:overflow-visible">
    {visibleShorts.map(({ youtubeId }) => {
      const thumbnail = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;

      return (
        <div
          class="short-card relative aspect-[9/16] overflow-hidden cursor-pointer group shrink-0 w-[58vw] sm:w-[40vw] md:w-auto snap-start"
          data-youtube-id={youtubeId}
        >
          <img
            src={thumbnail}
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />

          <button
            type="button"
            class="short-play absolute inset-0 flex items-end justify-start p-2 cursor-pointer group/play outline-none focus-visible:ring-2 focus-visible:ring-white"
            aria-label="Play short"
          >
            <span class="flex items-center justify-center w-11 h-11 bg-black/75 border-2 border-white transition-all duration-300 group-hover/play:scale-110 group-hover/play:bg-black">
              <svg
                viewBox="0 0 24 24"
                class="w-6 h-6 fill-white translate-x-[1px]"
                aria-hidden="true"
              >
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          </button>
        </div>
      );
    })}
  </div>
</section>

<div
  id="short-modal"
  class="fixed inset-0 bg-black/90 z-50 hidden items-center justify-center p-4 md:p-6"
>
  <button
    id="close-short-modal"
    type="button"
    class="absolute top-6 right-6 text-white text-3xl cursor-pointer outline-none focus:outline-none focus:ring-0 z-10"
    aria-label="Close video"
  >
    ✕
  </button>

  <div class="h-[85vh] aspect-[9/16] max-w-full">
    <iframe
      id="short-modal-video"
      class="w-full h-full"
      src=""
      title="Short video"
      allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</div>

<script>
  const shortCards = document.querySelectorAll(".short-card");
  const shortModal = document.getElementById("short-modal");
  const shortModalVideo = document.getElementById("short-modal-video");
  const closeShortModal = document.getElementById("close-short-modal");

  shortCards.forEach((card) => {
    const button = card.querySelector(".short-play");
    const youtubeId = card.getAttribute("data-youtube-id");

    if (
      !button ||
      !youtubeId ||
      !shortModal ||
      !(shortModalVideo instanceof HTMLIFrameElement)
    ) {
      return;
    }

    button.addEventListener("click", () => {
      shortModal.classList.remove("hidden");
      shortModal.classList.add("flex");

      document.body.style.overflow = "hidden";

      shortModalVideo.src =
        `https://www.youtube.com/embed/${youtubeId}?autoplay=1&playsinline=1&rel=0`;
    });
  });

  function closeShortPlayer() {
    if (
      !shortModal ||
      !(shortModalVideo instanceof HTMLIFrameElement)
    ) {
      return;
    }

    shortModalVideo.src = "";

    shortModal.classList.add("hidden");
    shortModal.classList.remove("flex");

    document.body.style.overflow = "";
  }

  closeShortModal?.addEventListener("click", closeShortPlayer);

  shortModal?.addEventListener("click", (event) => {
    if (event.target === shortModal) {
      closeShortPlayer();
    }
  });
</script>