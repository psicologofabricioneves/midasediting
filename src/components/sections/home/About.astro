---
// components
import Heading from "../../elements/Heading.astro";

// assets
import { Image } from "astro:assets";
import photo from "../../../assets/images/Fotoeu.jpg";
---

<section id="about" class="w-full m-auto xl:max-w-[85%] grid lg:grid-cols-2 gap-10 lg:gap-16 items-center scroll-mt-24">

    <div class="flex flex-col gap-6">
        <Heading tagName="h2" tagSize="h2">Psychology meets editing</Heading>
        <p class="font-mono text-16/7 text-base-900">
            I'm a psychologist and video editor with 4 years of experience, focused on creative YouTube content.
            I bring what I know about attention, behavior and storytelling into the way I edit, shaping pacing,
            retention and the overall viewer experience.
        </p>
        <p class="font-mono text-16/7 text-base-900">
            Outside the timeline, you'll probably find me surfing.
        </p>
    </div>

    <div class="grid grid-cols-[2fr_3fr] gap-3">
        <div class="border-2 border-base-900 p-2">
            <Image
                src={photo}
                alt="Midas in Brasília"
                widths={[240, 480]}
                sizes="(min-width: 1200px) 18vw, 38vw"
                format="webp"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale-75"
            />
        </div>
        <div class="border-2 border-base-900 p-2">
            <video
                id="about-video"
                data-src="/videos/about.mp4"
                poster="/videos/about-poster.webp"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Surfer walking on the beach with a board"
                class="w-full h-full object-cover"
            ></video>
        </div>
    </div>

</section>

<script>
  // Baixa o vídeo só quando ele está perto de aparecer e pausa fora da tela.
  const video = document.getElementById("about-video");

  if (video instanceof HTMLVideoElement) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!video.src) video.src = video.dataset.src ?? "";
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      },
      { rootMargin: "300px" }
    ).observe(video);
  }
</script>
