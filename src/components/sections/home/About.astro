---
// components
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
---

<Container variant={'xl'}>

    <Heading tagName="h2" tagSize="h2" class="text-center">
        ABOUT
    </Heading>

    <div class="flex lg:flex-row lg:gap-16 gap-10 flex-col">

        <div class="flex flex-col items-start gap-6 lg:pt-6 text-base-900 lg:flex-1">

            <Text variant={'xl'}>
                PSYCHOLOGY MEETS EDITING
            </Text>

            <Text variant={'sm'}>
                I'm a psychologist and video editor with 4 years of experience, focused on creative YouTube content.
                I bring what I know about attention, behavior and storytelling into the way
                I edit shaping pacing, retention and the overall viewer experience.
            </Text>

            <Text variant={'sm'}>
                Outside the timeline, you'll probably find me surfing.
            </Text>

        </div>

      <div class="w-full lg:flex-1 flex justify-center lg:justify-end">
    <div class="w-full max-w-[520px] aspect-[4/3] overflow-hidden border-2 border-base-900 p-3">
        <video
            id="about-video"
            data-src="/videos/about.mp4"
            poster="/videos/about-poster.webp"
            muted
            loop
            playsinline
            preload="none"
            class="w-full h-full object-cover"
        ></video>
    </div>
</div>

    </div>

</Container>

<script>
  // Baixa o vídeo só quando ele está perto de aparecer e pausa fora da tela.
  const video = document.getElementById("about-video");

  if (video instanceof HTMLVideoElement) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!video.src) video.src = video.dataset.src ?? "";
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      },
      { rootMargin: "300px" }
    ).observe(video);
  }
</script>