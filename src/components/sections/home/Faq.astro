---
// components
import Container from "../../elements/Container.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";

// assets
import { Image } from "astro:assets";
import ward from "../../../assets/clients/golden-roblox.jpg";
import sirius from "../../../assets/clients/client-6.jpg";
import golden from "../../../assets/clients/client-5.jpg";
import muitoHumildee from "../../../assets/clients/client-2.jpg";
import malcolm from "../../../assets/clients/client-3.jpg";
import imaLoser from "../../../assets/clients/client-4.webp";

// content
const clients = [
    {
        name: "WARD",
        main: "2.01M subscribers",
        detail: "Long-form for youtube",
        image: ward,
        url: "https://www.youtube.com/@WardGaming"
    },
     {
        name: "Sirius Roblox",
        main: "1.53M subscribers",
        detail: "Long-form for youtube",
        image: sirius,
        url: "https://www.youtube.com/@SiriusRobloxFunny"
    },
    {
        name: "Golden Roblox",
        main: "470k subscribers",
        detail: "Long-form for youtube",
        image: golden,
        url: "https://youtube.com/"
    },
    {
        name: "@muitohumildee",
        main: "1.51M on Instagram",
        detail: "Short-form for Instagram and Tiktok",
        image: muitoHumildee,
        url: "https://www.instagram.com/muitohumildee/"
    },
    {
        name: "Malcolm Crawford",
        main: "6.58K subscribers",
        detail: "Long-form and Short-form for youtube",
        image: malcolm,
        url: "https://www.youtube.com/@malcolmcrawford_"
    },
    {
        name: "IMALOSERONG",
        main: "790 followers on Kick",
        detail: "Live content",
        image: imaLoser,
        url: "https://kick.com/imaloserong"
    }
];
---

<Container variant={'lg'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">
        WORKED WITH
    </Heading>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-5 w-full">
        {
            clients.map((client) => (
                <div class="client-card flex flex-col items-center text-center border-3 border-base-900 p-6 cursor-default">

                    <a
                        href={client.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-32 h-32 rounded-full overflow-hidden border-3 border-base-900 mb-5 cursor-pointer"
                        aria-label={`Visit ${client.name}`}
                    >
                        <Image
                            src={client.image}
                            alt={client.name}
                            width={256}
                            height={256}
                            fit="cover"
                            format="webp"
                            loading="lazy"
                            decoding="async"
                            class="client-image w-full h-full object-cover transition-transform duration-300"
                        />
                    </a>

                    <div class="flex flex-col gap-2 items-center">

                        <p class="font-mono font-bold text-lg uppercase text-base-900">
                            {client.name}
                        </p>

                        <Text
                            variant={'sm'}
                            class="text-base-900"
                        >
                            {client.main}
                        </Text>

                        <Text
                            variant={'xsm'}
                            class="text-base-900 opacity-70"
                        >
                            {client.detail}
                        </Text>

                    </div>

                </div>
            ))
        }
    </div>

    <ContainerBottom />
</Container>

<style>
    .client-card:hover .client-image {
        transform: scale(1.08);
    }
</style>