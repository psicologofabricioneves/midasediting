---
// components
import Container from "../../elements/Container.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";

// content
const clients = [
    {
        name: "WARD FAMILY",
        main: "4M+ combined subscribers",
        detail: "Long-form for Golden Roblox • 469K subscribers",
        image: "/clients/golden-roblox.jpg",
        url: "https://www.youtube.com/@WardGaming"
    },
    {
        name: "@muitohumildee",
        main: "1,5M on Instagram",
        detail: "Short-form content",
        image: "/clients/client-2.jpg",
        url: "https://www.instagram.com/muitohumildee/"
    },
    {
        name: "Malcolm Crawford",
        main: "6.58K subscribers",
        detail: "Long-form and Short-form for youtube",
        image: "/clients/client-3.jpg",
        url: "https://www.youtube.com/@malcolmcrawford_"
    },
    {
        name: "IMALOSERONG",
        main: "790 followers on Kick",
        detail: "Live content",
        image: "/clients/client-4.webp",
        url: "https://kick.com/imaloserong"
    }
];
---

<Container variant={'lg'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">
        WORKED WITH
    </Heading>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 w-full">
        {
            clients.map((client) => (
                <div class="client-card flex flex-col items-center text-center border-3 border-base-900 p-6 cursor-default">

                    <a
    href={client.url}
    target="_blank"
    rel="noopener noreferrer"
    class="w-32 h-32 rounded-full overflow-hidden border-3 border-base-900 mb-5 cursor-pointer"
    aria-label={`Visit ${client.name}`}
>
    <img
        src={client.image}
        alt={client.name}
        class="client-image w-full h-full object-cover transition-transform duration-300"
    />
</a>

                    <div class="flex flex-col gap-2 items-center">

                        <Text
                            variant={'lg'}
                            class="text-base-900 uppercase"
                        >
                            {client.name}
                         </Text>

                        <Text
                            variant={'sm'}
                            class="text-base-900"
                        >
                            {client.main}
                        </Text>

                        <Text
                            variant={'xsm'}
                            class="text-base-900 opacity-70"
                        >
                            {client.detail}
                        </Text>

                    </div>

                </div>
            ))
        }
    </div>

    <ContainerBottom />
</Container>

<style>
    .client-card:hover .client-image {
        transform: scale(1.08);
    }
</style>