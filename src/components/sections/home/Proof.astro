---
// assets
import { Image } from "astro:assets";

// content
import { topClients, otherClients } from "../../../data/site";
---

<section class="w-full m-auto xl:max-w-[85%] border-y-2 border-base-900 py-6" aria-label="Clients">
    <div class="flex flex-col lg:flex-row lg:items-center gap-8 lg:gap-12">

        <div class="shrink-0">
            <p class="font-grunge text-base-900 text-96" style="line-height: 0.8">5.5M</p>
            <p class="font-mono text-12 uppercase text-base-800 mt-2">Combined audience of my clients</p>
        </div>

        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-4 flex-1">
            {topClients.map((client) => (
                <li>
                    <a href={client.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 group">
                        <Image
                            src={client.image}
                            alt=""
                            width={112}
                            height={112}
                            fit="cover"
                            format="webp"
                            loading="lazy"
                            decoding="async"
                            class="w-12 h-12 md:w-14 md:h-14 shrink-0 rounded-full object-cover border-2 border-base-900"
                        />
                        <span class="min-w-0">
                            <span class="block font-mono font-bold text-12 md:text-16 uppercase text-base-900 group-hover:underline break-words">{client.name}</span>
                            <span class="block font-mono text-12 text-base-800">{client.reach}</span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </div>

    <p class="font-mono text-12 uppercase text-base-700 mt-6">
        Also with{" "}
        {otherClients.map((client, index) => (
            <>
                {index > 0 && " + "}
                <a href={client.url} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-base-900">{client.name}</a>
            </>
        ))}
    </p>
</section>
