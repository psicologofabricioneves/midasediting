---
// components
import Heading from "../../elements/Heading.astro";
import Work from "../../elements/Work.astro";

// content
import { longForm } from "../../../data/videos";
const featuredWorks = longForm.filter((video) => video.featured);
---

<section id="work" class="w-full m-auto xl:max-w-[85%] flex flex-col gap-12 lg:gap-16 scroll-mt-24">
    <Heading tagName="h2" tagSize="h2">The work</Heading>
    <div class="grid md:grid-cols-2 gap-x-6 gap-y-12">
        {featuredWorks.map((video) => (
            <Work
                youtubeId={video.youtubeId}
                title={video.title}
                client={video.client}>
            </Work>
        ))}
    </div>
</section>
