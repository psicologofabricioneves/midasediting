---
// components
import Container from "../../elements/Container.astro"
import Text from "../../elements/Text.astro"
import Heading from "../../elements/Heading.astro"
import ImageContainer from "../../elements/ImageContainer.astro"
import Link from "../../elements/Link.astro"

// assets
import peter from "../../../assets/images/Fotoeu.jpg";
---

<Container variant={"xl"} class="flex flex-col gap-8 min-h-screen mb-8 md:-mb-32">
    <Text variant={'xl'} class="text-base-900 lg:max-w-1/3 md:max-w-1/2 w-full">Hi, I'm Midas, a video editor, short and long form for youtube, working with storytelling, retention and pacing, it's a pleasure! </Text>
    <Container class="flex md:flex-row flex-col gap-8">
        <Container class="md:flex-2 flex flex-col items-start gap-4 md:-translate-y-15">
    <Link variant={'button'} href="/contact">Available for work</Link>
    <Heading tagName="h1" tagSize="h1">Midas Editing</Heading>
</Container>
        <Container class="h-full md:h-[500px] flex-1 md:-translate-y-60">
    <ImageContainer src={peter} alt="Midas Editing" />
</Container>
    </Container>
</Container>

