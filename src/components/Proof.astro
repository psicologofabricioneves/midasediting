---
import { Image } from "astro:assets";
import Chapter from "./Chapter.astro";
import { topClients } from "../data/site";
---

<Chapter name="Proof" class="-mt-8 md:-mt-16">
    <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5">
            <p class="display gold-word w-fit text-[30vw] lg:text-[13vw]" style="line-height: 0.85">5.5M</p>
            <p class="text-lg md:text-xl leading-snug max-w-sm mt-5">
                people follow the creators who already trust me with their footage.
            </p>
        </div>

        <ul class="lg:col-span-7 border-t border-lead/40">
            {topClients.map((client) => (
                <li class="client-row border-b border-lead/40">
                    <a href={client.url} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 py-4 md:py-5 hover:text-gold transition-colors">
                        <Image src={client.image} alt="" width={112} height={112} fit="cover" format="webp" loading="lazy" decoding="async" class="w-11 h-11 md:w-14 md:h-14 shrink-0 rounded-full object-cover" />
                        <span class="display text-xl md:text-4xl min-w-0 break-words flex-1">{client.name}</span>
                        <span class="text-right shrink-0">
                            <span class="block font-mono text-sm md:text-lg">{client.reach}</span>
                            <span class="block eyebrow">{client.unit}</span>
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</Chapter>
