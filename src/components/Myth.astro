---
import Chapter from "./Chapter.astro";
---

<Chapter name="Myth">
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-center">
        <div class="lg:flex-1 flex flex-col gap-6">
            <h2 class="display text-6xl md:text-[6.5vw]">In the myth, he couldn't turn it off.</h2>
            <p class="text-lg leading-relaxed max-w-xl">
                I'm a psychologist and a video editor with 4 years of experience, focused on creative YouTube content.
                I bring what I know about attention, behavior and storytelling into every cut, shaping pacing, retention
                and the way a video feels to watch.
            </p>
            <p class="text-lg leading-relaxed max-w-xl">
                King Midas finally lost the touch by washing it off in a river. <span class="text-gold">I go surfing.</span>
            </p>
        </div>

        <div class="w-full lg:flex-1 flex justify-center lg:justify-end">
            <video
                data-src="/videos/about-sunset.mp4"
                poster="/videos/about-sunset-poster.webp"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Surfer walking on the beach with a board at sunset"
                class="w-full max-w-[520px] aspect-[4/3] object-cover"
            ></video>
        </div>
    </div>
</Chapter>
