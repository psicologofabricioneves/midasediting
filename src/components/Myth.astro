---
import { Image } from "astro:assets";
import Chapter from "./Chapter.astro";
import photo from "../assets/images/Fotoeu.jpg";
---

<Chapter name="Myth">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 flex flex-col gap-6">
            <h2 class="display text-6xl md:text-[6.5vw]">In the myth, he <span class="gold-word">couldn't turn it off.</span></h2>
            <p class="text-lg leading-relaxed max-w-xl">
                I'm a psychologist and a video editor with 4 years of experience, focused on creative YouTube content.
                I bring what I know about attention, behavior and storytelling into every cut, shaping pacing, retention
                and the way a video feels to watch.
            </p>
            <p class="text-lg leading-relaxed max-w-xl">
                King Midas finally lost the touch by washing it off in a river. <span class="text-gold">I go surfing.</span>
            </p>
        </div>

        <div class="lg:col-span-6 grid grid-cols-[2fr_3fr] gap-3">
            <Image src={photo} alt="Midas in Brasília" widths={[240, 480]} sizes="(min-width: 1024px) 20vw, 38vw" format="webp" loading="lazy" decoding="async" class="gild w-full h-full object-cover aspect-[3/4]" />
            <video
                data-src="/videos/about.mp4"
                poster="/videos/about-poster.webp"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Surfer walking on the beach with a board"
                class="gild w-full h-full object-cover"
            ></video>
        </div>
    </div>
</Chapter>
