---
import Chapter from "./Chapter.astro";
import VideoCard from "./VideoCard.astro";
import { longForm, shorts } from "../data/videos";

const featured = longForm.filter((video) => video.featured);
const featuredShorts = shorts.filter((video) => video.featured);
---

<Chapter name="Work" id="work">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 md:mb-14">
        <h2 class="display text-6xl md:text-[8vw]">Touch <span class="gold-word">anything.</span></h2>
        <p class="max-w-xs text-lead md:text-right">Everything here starts as lead. Touch it to see it the way it was edited.</p>
    </div>

    <p class="eyebrow mb-4">Long form</p>
    <div class="grid md:grid-cols-2 gap-x-6 gap-y-10">
        {featured.map((video) => (
            <VideoCard
                youtubeId={video.youtubeId}
                title={video.title}
                client={video.client}
                sizes="(min-width: 768px) 48vw, 100vw"
            />
        ))}
    </div>

    <p class="eyebrow mt-20 mb-4">Short form</p>
    <div class="flex md:grid md:grid-cols-5 gap-3 overflow-x-auto snap-x -mx-5 px-5 md:mx-0 md:px-0 md:overflow-visible">
        {featuredShorts.map((video) => (
            <VideoCard
                class="shrink-0 w-[58vw] sm:w-[38vw] md:w-auto snap-start"
                youtubeId={video.youtubeId}
                vertical
                sizes="(min-width: 768px) 19vw, (min-width: 640px) 38vw, 58vw"
            />
        ))}
    </div>
</Chapter>
